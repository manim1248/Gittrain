name: Convert Markdown to PDF

on:
  push:
    branches:
      - main  # Change to 'master' if your default branch is master
    paths:
      - '**.md' # Triggers only when markdown files are updated

jobs:
  build-pdf:
    runs-on: ubuntu-latest
    steps:
      # Step 1: Checkout the repository code
      - name: Checkout Repository
        uses: actions/checkout@v4

      # Step 2: Run the Markdown-to-PDF conversion action
      - name: Generate PDFs from Markdown
        uses: baileyjm02/markdown-to-pdf@v1
        with:
          input_path: .          # Root directory (scans all folders for .md files)
          output_dir: pdf-output # Folder where generated PDFs will be saved
          table_of_contents: true # Optional: generates a TOC

      # Step 3: Upload the generated PDFs as artifacts for download
      - name: Upload PDF Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: markdown-pdfs
          path: pdf-output/*.pdf
